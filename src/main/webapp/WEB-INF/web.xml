<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <servlet>
        <servlet-name>JerseyContainer</servlet-name>
        <servlet-class>org.glassfish.jersey.servlet.ServletContainer</servlet-class>
        <init-param>
            <param-name>jakarta.ws.rs.Application</param-name>
            <param-value>lk.jiat.fiadabook.config.AppConfig</param-value>
        </init-param>
        <load-on-startup>1</load-on-startup>
    </servlet>

    <filter>
        <filter-name>AuthAccessFilter</filter-name>
        <filter-class>lk.jiat.fiadabook.middleware.AuthAccessFilter</filter-class>
    </filter>


    <servlet-mapping>
        <servlet-name>JerseyContainer</servlet-name>
        <url-pattern>/api/*</url-pattern>
    </servlet-mapping>
    <filter-mapping>
        <filter-name>AuthAccessFilter</filter-name>
        <url-pattern>/signUp.html</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthAccessFilter</filter-name>
        <url-pattern>/signIn.html</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>AccessControlFilter</filter-name>
        <filter-class>lk.jiat.fiadabook.middleware.AccessControlFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AccessControlFilter</filter-name>
        <url-pattern>/user.html</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>AdminAccessControlFilter</filter-name>
        <filter-class>lk.jiat.fiadabook.middleware.AdminAccessControlFilter</filter-class>
    </filter>

    <filter-mapping>
        <filter-name>AdminAccessControlFilter</filter-name>
        <url-pattern>/admin.html</url-pattern>
    </filter-mapping>

    <filter-mapping>
        <filter-name>AdminAccessControlFilter</filter-name>
        <url-pattern>/api/admin/*</url-pattern>
    </filter-mapping>
</web-app>